from os import PathLike

class Scenario:
    @property
    def name(self) -> str: ...
    @property
    def description(self) -> str: ...
    @property
    def wheel(self) -> str: ...
    @property
    def seconds(self) -> float: ...
    @property
    def release_s(self) -> float: ...

def load_scenario(path: str | PathLike[str]) -> Scenario: ...
def channels_json() -> str: ...
def load_recording_json(path: str | PathLike[str]) -> str: ...
def run_scenario_json(
    scenario: Scenario,
    firmware_path: str | PathLike[str],
    *,
    profiles_dir: str | PathLike[str] | None = None,
    symbols_path: str | PathLike[str] | None = None,
    sample_hz: float = 100.0,
    max_samples: int = 100_000,
    max_seconds: float = 600.0,
    max_wall_seconds: float = 300.0,
) -> str: ...

class Session:
    def __init__(
        self,
        scenario: Scenario,
        firmware_path: str | PathLike[str],
        *,
        profiles_dir: str | PathLike[str] | None = None,
        symbols_path: str | PathLike[str] | None = None,
        sample_hz: float = 100.0,
        max_samples: int = 100_000,
        max_seconds: float = 600.0,
        max_wall_seconds: float = 300.0,
    ) -> None: ...
    @property
    def time_s(self) -> float: ...
    @property
    def sample_hz(self) -> float: ...
    @property
    def sample_count(self) -> int: ...
    @property
    def finished(self) -> bool: ...
    @property
    def halted(self) -> str | None: ...
    def step_json(self, n: int = 1) -> str: ...
    def reset(self) -> None: ...
    def set_manual(self, lean: float, steer: float) -> None: ...
    def release_manual(self) -> None: ...
    def set_push(self, newtons: float) -> None: ...
    def set_held(self, held: bool) -> None: ...
    def step_off(self) -> None: ...
    def samples_json(self) -> str: ...
    def events_json(self) -> str: ...
    def result_json(self) -> str: ...
    def save(self, path: str | PathLike[str]) -> None: ...

__version__: str
